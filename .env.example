CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/cricket-club/public/'
app.appTimezone = 'Asia/Kolkata'
database.default.hostname = localhost
database.default.database = mcc_cricket_club
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
# Generate a unique encryption.key before deployment.

# WhatsApp OTP provider (leave empty to fail closed)
whatsapp.apiUrl =
whatsapp.token =
whatsapp.sender =
whatsapp.timeout = 10
PORTAL_OTP_DEBUG = false
PORTAL_OTP_PROVIDER = configured
